<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 添加顶部工具栏样式布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_menu_revert"
            android:contentDescription="@string/return_back"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/page_add"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- 快速添加提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_add"
                android:textColor="#FFA500"
                android:layout_marginBottom="8dp" />

            <!-- 复制/链接/识图/排期等 -->
            <EditText
                android:id="@+id/etQuickAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_methods"
                android:textColorHint="#FFA500"
                android:layout_marginBottom="16dp" />

            <!-- 基础信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/basic_info"
                android:textColor="#FFA500"
                android:layout_marginBottom="8dp" />

            <!-- 名称 -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/perform_name"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- 场地 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/venue"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnSelectVenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_venue"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/date_time"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/etDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="@string/date_time_hint"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"
                    tools:ignore="TextFields" />
            </LinearLayout>

            <!-- 演出状态 -->
            <Spinner
                android:id="@+id/spnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/select_status_prompt"
                android:entries="@array/status_options"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <!-- 分类 -->
            <Spinner
                android:id="@+id/spnCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/select_category_prompt"
                android:entries="@array/category_options"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <!-- 海报 -->
            <Button
                android:id="@+id/btnAddPoster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_poster"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- 阵容输入 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/performers"
                android:textColor="#FFA500"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPerformer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_performers"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnAddPerformer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_performer"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- 演出者容器 -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/llPerformersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:flexWrap="wrap" />

            <!-- 嘉宾输入 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guests"
                android:textColor="#FFA500"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_guests"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnAddGuest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_guest"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- 嘉宾容器 -->
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/llGuestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:flexWrap="wrap" />

            <!-- 嘉宾 -->
            <Button
                android:id="@+id/btnAddGuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_guest"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- 我的评价 -->
            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:rating="0"
                android:stepSize="1"
                android:layout_marginBottom="8dp" />

            <!-- 票价 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ticket_price"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etTicketPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/add_ticket_price"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp" />
                <Spinner
                    android:id="@+id/spnTicketPriceCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- 实付 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/actual_paid"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etActualPaid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/add_paid_price"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp" />
                <Spinner
                    android:id="@+id/spnActualPaidCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- 其他费用 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/other_fees"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/etOtherFees"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/add_other_price"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp" />
                <Spinner
                    android:id="@+id/spnOtherFeesCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <!-- 座位号 -->
            <EditText
                android:id="@+id/etSeatNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_seat_number"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- 备注 -->
            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_ps"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>